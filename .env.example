# Base URL of the Glances REST API (must end with /api/4)
PUBLIC_GLANCES_URL=http://localhost:61208/api/4

# Server settings (read by the adapter-node server on `bun start`)
# PORT=61209
# HOST=0.0.0.0

# Polling interval (ms) for the SSE proxy stream (server-side only, default 2000)
# GLANCES_POLL_MS=2000
