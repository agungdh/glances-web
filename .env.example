# Comma-separated list of Glances REST API base URLs (each must end with /api/4)
# Example: PUBLIC_GLANCES_URLS=http://host1:61208/api/4,http://host2:61208/api/4
PUBLIC_GLANCES_URLS=http://localhost:61208/api/4

# Single-host fallback when PUBLIC_GLANCES_URLS is empty
PUBLIC_GLANCES_URL=http://localhost:61208/api/4

# Optional per-host credentials for Glances servers running with basic auth
# (glances -w -u <user> -p <pass>). Comma-separated list of `url|username|password`
# entries; url must match an entry in PUBLIC_GLANCES_URLS (server-side only, never
# exposed to the browser).
# Example: GLANCES_CREDENTIALS=http://192.168.1.40:61208/api/4|admin|secret,http://host2:61208/api/4|user|pass

# Server settings (read by the adapter-node server on `bun start`)
# PORT=61209
# HOST=0.0.0.0

# Polling interval (ms) for the shared Glances data cache (server-side only, default 2000)
# GLANCES_POLL_MS=2000

# Optional HTTP Basic auth for the dashboard and its API routes. When both are
# set, the browser is prompted for credentials before any page or API data is
# served (server-side only, never exposed to the browser).
# BASIC_AUTH_USERNAME=admin
# BASIC_AUTH_PASSWORD=secret
